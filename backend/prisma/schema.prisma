generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  passwordHash     String
  salary           Float?
  foodDailyLimit   Float              @default(12)
  foodMonthlyLimit Float              @default(350)
  pushToken        String?            @unique
  createdAt        DateTime           @default(now())
  expenses         Expense[]
  pushSubscriptions PushSubscription[]
  budgets          Budget[]
  recurringExpenses RecurringExpense[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Budget {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category String // "TOTAL" arba kategorijos kodas (MAISTAS, KURAS, ...)
  amount   Float

  @@unique([userId, category])
}

model RecurringExpense {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      String
  amount        Float
  note          String?
  dayOfMonth    Int      // 1-28
  active        Boolean  @default(true)
  lastAppliedYm String?  // "2026-07" — paskutinis mėnuo, kai išlaida sukurta
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Expense {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String   // MAISTAS | KURAS | RUBAI | NEBUTINOS | KITOS
  amount    Float
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, date])
}
