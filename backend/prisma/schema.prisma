generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  passwordHash     String
  salary           Float?
  savings          Float?             // atsargų fondas (emergency fund)
  foodDailyLimit   Float              @default(12)
  foodMonthlyLimit Float              @default(350)
  pushToken        String?            @unique
  createdAt        DateTime           @default(now())
  expenses         Expense[]
  pushSubscriptions PushSubscription[]
  budgets          Budget[]
  recurringExpenses RecurringExpense[]
  categories       Category[]
  debts            Debt[]
  balanceChecks    BalanceCheck[]
}

model BalanceCheck {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance     Float    // įvestas realus sąskaitos likutis
  income      Float    @default(0) // gautos pajamos nuo praėjusio patikrinimo
  unaccounted Float?   // neapskaitytos išlaidos lyginant su ankstesniu patikrinimu
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Debt {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String    // BORROWED (aš skolingas) | LENT (man skolingi)
  principal Float
  remaining Float
  interestRate Float? // metinė palūkanų norma % (strategijų simuliatoriui)
  minPayment   Float? // minimalus mėnesio mokėjimas
  note      String?
  createdAt DateTime  @default(now())
  closedAt  DateTime?

  @@index([userId])
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   // MAISTAS, KURAS... arba custom (pvz. GYVUNAI)
  label     String
  emoji     String
  color     String   // pagrindinė spalva (dot/bar)
  soft      String   // šviesus fonas
  isDefault Boolean  @default(false)
  archived  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, code])
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Budget {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category String // "TOTAL" arba kategorijos kodas (MAISTAS, KURAS, ...)
  amount   Float
  rollover Boolean @default(false) // vokelių režimas: nepanaudotas likutis keliauja į kitą mėnesį

  @@unique([userId, category])
}

model RecurringExpense {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      String
  amount        Float
  note          String?
  dayOfMonth    Int      // 1-28
  active        Boolean  @default(true)
  lastAppliedYm String?  // "2026-07" — paskutinis mėnuo, kai išlaida sukurta
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Expense {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String   // MAISTAS | KURAS | RUBAI | NEBUTINOS | KITOS
  amount    Float
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, date])
}
