# Duomenų bazė (SQLite - nereikia jokio išorinio serverio)
DATABASE_URL="file:./dev.db"

# JWT Slaptažodis (pakeisk į ilgą, atsitiktinį stringą produkcijai!)
JWT_SECRET="keis_si_i_stipru_slaptazodi_produkcijoje_minimum_32_simboliai"

# Serverio portas
PORT=3001

# Frontend URL (CORS)
FRONTEND_URL="http://localhost:5173"

# Aplinka
NODE_ENV="development"

# Savaitinio push digest cron apsauga (kviesti POST /api/push/digest su X-Digest-Secret header'iu)
DIGEST_SECRET="sugeneruok_ilga_atsitiktine_eilute"
