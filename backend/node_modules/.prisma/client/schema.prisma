generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  salary           Float? // Mėnesinis atlyginimas
  foodDailyLimit   Float     @default(12) // Dienos maisto limitas €
  foodMonthlyLimit Float     @default(350) // Mėnesio maisto limitas €
  createdAt        DateTime  @default(now())
  expenses         Expense[]
}

model Expense {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String // MAISTAS | KURAS | RUBAI | NEBUTINOS | KITOS
  amount    Float
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, date])
}
